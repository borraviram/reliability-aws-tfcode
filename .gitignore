# Ignore all .terraform directories (provider plugins, modules metadata, etc.)
.terraform/
**/.terraform/

# Ignore Terraform state and backup files
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.backup

# Ignore crash logs
crash.log
crash.*.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform plan output files
*.tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore sensitive variable files (keep example files)
*.tfvars
!*.tfvars.example
!environments/*/terraform.tfvars
!environments/*/backend.tfvars
